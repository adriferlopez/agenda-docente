# La configuración de Firebase (apiKey, authDomain, etc.) ya está incrustada
# directamente en src/firebase/config.ts y no necesita variables de entorno.

# Client ID de Google OAuth (Google Calendar / Google Drive) — para cuando
# se implementen esas integraciones.
# Crear en Google Cloud Console > APIs y servicios > Credenciales
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# NOTA IMPORTANTE SOBRE SEGURIDAD:
# La clave de Gemini de cada docente NUNCA se guarda aquí ni en el frontend.
# Se introduce desde Ajustes > IA dentro de la app, se cifra (AES-256-GCM)
# en una Cloud Function antes de guardarse en Firestore, y solo se
# descifra en el servidor (Cloud Function) en el momento de llamar a la
# API de Gemini. La clave de cifrado maestra (GEMINI_ENCRYPTION_KEY) vive
# como secreto de Cloud Functions, nunca en el repositorio.
