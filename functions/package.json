{
  "name": "functions",
  "description": "Cloud Functions para Agenda Docente (IA Gemini, gestión segura de claves)",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "docx": "^9.7.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "nodemailer": "^9.0.5",
    "pizzip": "^3.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.24",
    "typescript": "^5.7.3"
  }
}
