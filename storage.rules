rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Cada docente solo puede leer/escribir dentro de su propia carpeta
    // /users/{uid}/... Ejemplo:
    //  - /users/{uid}/annual/{planId}.jpg (imagen de referencia programación anual)
    // Nota: los adjuntos de Reuniones usan enlaces de Google Drive y no
    // requieren Storage. Este bucket es opcional; solo es necesario si
    // activas la subida de imagen de referencia en Programación anual.
    match /users/{userId}/{allPaths=**} {
      // "read" no tiene request.resource (eso solo existe al escribir), así
      // que las comprobaciones de tamaño/tipo van solo en "write"; si no, la
      // regla lanza un error al evaluar un campo inexistente y deniega
      // también la lectura de tus propios archivos.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
